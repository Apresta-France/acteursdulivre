APP_NAME="Acteurs du Livre"
APP_URL=https://acteursdulivre.test
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_TIMEZONE=Europe/Paris

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=acteursdulivre
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=bonjour@acteursdulivre.fr
MAIL_FROM_NAME="Acteurs du Livre"

SESSION_NAME=adl_session

# Connexion sociale (Google / Facebook) — à activer de préférence dans
# Administration → Connexion Google / Facebook (clés + interrupteurs).
# Ces variables ne servent que de secours si rien n'est enregistré en admin.
OAUTH_ENABLED=false
OAUTH_GOOGLE_ENABLED=true
OAUTH_FACEBOOK_ENABLED=true

# Connexion Google — console.cloud.google.com (Identifiants OAuth, type « Application Web »)
# URI de redirection : {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Connexion Facebook — developers.facebook.com (Connexion Facebook, OAuth)
# URI de redirection : {APP_URL}/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
